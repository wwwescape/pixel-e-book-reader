<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Only used for the window background shown before Compose renders; all real UI theming is done in ui/theme/Theme.kt.
         A plain platform theme (dark variant in values-night) rather than Material Components' Theme.Material3,
         so the app doesn't need the whole View-based Material library just for a window background. -->
    <style name="Theme.PixelEBookReader.Base" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.PixelEBookReader" parent="Theme.PixelEBookReader.Base">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Shown by MainActivity only, via installSplashScreen(); hands off to Theme.PixelEBookReader once the first frame is ready. -->
    <style name="Theme.PixelEBookReader.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PixelEBookReader</item>
    </style>
</resources>
