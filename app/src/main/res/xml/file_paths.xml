<?xml version="1.0" encoding="utf-8"?>
<!-- Only exposes a dedicated subfolder of the app's cache dir — currently just used to share a
     crash report text file (see CrashActivity) — so nothing else in the cache (temporary book
     copies) is ever addressable through the provider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="shared_files" path="shared/" />
</paths>
